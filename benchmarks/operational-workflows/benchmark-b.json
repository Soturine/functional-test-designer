    "requirements.md": "# Legacy pricing workflow\n\n## RF-010 Apply a discount\n\nAcceptance criteria:\n\n- Applying a valid discount code reduces the total and records the applied code.\n\n## RF-011 Refuse an expired discount\n\nAcceptance criteria:\n\n- An expired discount code is refused and the total remains unchanged.\n",
    "legacy_service.py": "\"\"\"Legacy pricing service.\"\"\"\n\nSTATUS_REFUSED = \"REFUSED\"\nLEGACY_ROUNDING = \"FLOOR\"\n\n\ndef apply_discount(total, code, expired):\n    if expired:\n        return total, STATUS_REFUSED\n    # The legacy route floors the discounted total instead of rounding it.\n    return int(total * 0.9), \"APPLIED\"\n",
    "legacy_test_pricing.py": "\"\"\"Existing legacy pricing tests.\"\"\"\n\n\ndef test_expired_code_is_refused():\n    \"\"\"An expired discount code is refused.\"\"\"\n    assert True\n\n\ndef test_discount_uses_floor_rounding():\n    assert True\n\n\nclass TestSerializers:\n    def test_payload_shape(self):\n        assert True\n"
