{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/functional-test-designer/test-case.schema.json",
  "title": "Functional manual test case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "priority",
    "type",
    "objective",
    "requirement_refs",
    "scenario_refs",
    "coverage_point_refs",
    "source_refs",
    "preconditions",
    "test_data",
    "steps",
    "postconditions",
    "cleanup",
    "tags",
    "notes"
  ],
  "properties": {
    "schema_version": {"enum": ["1.2", "2.2"]},
    "id": {"type": "string", "pattern": "^TC-[0-9]{3,}$"},
    "title": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY", "NEEDS_REVIEW", "BLOCKED", "BLOCKED_REQUIREMENT", "BLOCKED_IMPLEMENTATION_GAP", "BLOCKED_ENVIRONMENT", "BLOCKED_TEST_DATA", "BLOCKED_EXTERNAL_DEPENDENCY", "EXPLORATORY"]},
    "priority": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
    "type": {"enum": ["FUNCTIONAL", "NEGATIVE", "BOUNDARY", "SECURITY", "AUTHORIZATION", "PERFORMANCE", "RESILIENCE", "RECOVERY", "CONCURRENCY", "RACE_CONDITION", "IDEMPOTENCY", "INTEGRATION", "CONTRACT", "DATA_INTEGRITY", "AUDIT", "STATE_TRANSITION", "E2E", "FIELD", "HARDWARE_INTEGRATION", "CHAOS", "EXPLORATORY"]},
    "test_basis": {"enum": ["ACCEPTANCE", "CHARACTERIZATION", "DERIVED", "EXPLORATORY", "REGRESSION", "E2E"]},
    "primary_type": {"enum": ["FUNCTIONAL", "NEGATIVE", "BOUNDARY", "SECURITY", "AUTHORIZATION", "PERFORMANCE", "RESILIENCE", "RECOVERY", "CONCURRENCY", "RACE_CONDITION", "IDEMPOTENCY", "INTEGRATION", "CONTRACT", "DATA_INTEGRITY", "AUDIT", "STATE_TRANSITION", "E2E", "FIELD", "HARDWARE_INTEGRATION", "CHAOS", "EXPLORATORY"]},
    "secondary_tags": {"$ref": "#/$defs/uniqueStringList"},
    "execution_status": {"enum": ["READY", "NEEDS_REVIEW", "BLOCKED_REQUIREMENT", "BLOCKED_IMPLEMENTATION_GAP", "BLOCKED_ENVIRONMENT", "BLOCKED_TEST_DATA", "BLOCKED_EXTERNAL_DEPENDENCY", "EXPLORATORY"]},
    "question_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^Q-[0-9]{3,}$"}},
    "finding_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^FND-[0-9]{3,}$"}},
    "composes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^TC-[0-9]{3,}$"}},
    "automation_candidate": {"type": "boolean"},
    "automation_layer": {"enum": ["UI", "API", "SERVICE", "INTEGRATION", "HARDWARE", "MIXED", "NONE"]},
    "automation_tool_hint": {"enum": ["PLAYWRIGHT", "API_TEST", "TESTSPRITE", "PYTEST", "OTHER", "NONE"]},
    "deterministic": {"type": "boolean"},
    "objective": {"type": "string", "minLength": 1},
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}
    },
    "scenario_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SCN-[0-9]{3,}$"}
    },
    "coverage_point_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CP-[0-9]{3,}$"}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceRef"}
    },
    "preconditions": {"$ref": "#/$defs/stringList"},
    "test_data": {"type": "array", "items": {"$ref": "#/$defs/testData"}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "postconditions": {"$ref": "#/$defs/stringList"},
    "cleanup": {"$ref": "#/$defs/stringList"},
    "tags": {"$ref": "#/$defs/uniqueStringList"},
    "notes": {"$ref": "#/$defs/stringList"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.2"}}, "required": ["schema_version"]},
      "then": {"required": ["test_basis", "primary_type", "secondary_tags", "execution_status", "question_refs", "finding_refs", "composes", "automation_candidate", "automation_layer", "automation_tool_hint", "deterministic"]}
    },
    {
      "if": {"properties": {"status": {"const": "READY"}}, "required": ["status"]},
      "then": {
        "properties": {
          "steps": {"items": {"properties": {"needs_clarification": {"const": false}}}}
        }
      }
    }
  ],
  "$defs": {
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "uniqueStringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "testData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "action", "expected_result", "needs_clarification"],
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "action": {"type": "string", "minLength": 1},
        "expected_result": {"type": ["string", "null"], "minLength": 1},
        "needs_clarification": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"expected_result": {"type": "null"}}, "required": ["expected_result"]},
          "then": {"properties": {"needs_clarification": {"const": true}}}
        }
      ]
    }
  }
}
