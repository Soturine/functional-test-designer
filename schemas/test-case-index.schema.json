{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/functional-test-designer/test-case-index.schema.json",
  "title": "Functional test case index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "sources",
    "requirements",
    "coverage_points",
    "scenarios",
    "test_cases"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/requirement"}
    },
    "coverage_points": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coveragePoint"}
    },
    "scenarios": {
      "type": "array",
      "items": {"$ref": "#/$defs/scenario"}
    },
    "test_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/testCaseEntry"}
    }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "reference"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "source_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["TESTABLE", "NEEDS_CLARIFICATION"]},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        }
      }
    },
    "coveragePoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_ref", "statement", "source_refs", "disposition", "target_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^CP-[0-9]{3,}$"},
        "requirement_ref": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"},
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceRef"}
        },
        "disposition": {"enum": ["TEST_CASE", "QUESTION", "OUT_OF_SCOPE"]},
        "target_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "TEST_CASE"}}, "required": ["disposition"]},
          "then": {
            "properties": {
              "target_refs": {
                "minItems": 1,
                "items": {"type": "string", "pattern": "^TC-[0-9]{3,}$"}
              }
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "QUESTION"}}, "required": ["disposition"]},
          "then": {
            "properties": {
              "target_refs": {
                "minItems": 1,
                "items": {"type": "string", "pattern": "^Q-[0-9]{3,}$"}
              }
            }
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "OUT_OF_SCOPE"}}, "required": ["disposition"]},
          "then": {
            "required": ["reason"],
            "properties": {"target_refs": {"maxItems": 0}}
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "requirement_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^SCN-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "HAPPY_PATH",
            "NEGATIVE",
            "BOUNDARY",
            "PERMISSION",
            "STATE_TRANSITION",
            "RECOVERY",
            "EXPLORATORY"
          ]
        },
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}
        }
      }
    },
    "testCaseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "requirement_refs",
        "scenario_refs",
        "coverage_point_refs",
        "file"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^TC-[0-9]{3,}$"},
        "title": {"type": "string", "minLength": 1},
        "status": {"enum": ["READY", "NEEDS_REVIEW", "BLOCKED"]},
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}
        },
        "scenario_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SCN-[0-9]{3,}$"}
        },
        "coverage_point_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^CP-[0-9]{3,}$"}
        },
        "file": {"type": "string", "pattern": "^test-cases/TC-[0-9]{3,}\\.json$"}
      }
    }
  }
}
